# This file shows the frontend environment variables other setups need to create.
REACT_APP_API_URL=http://localhost:3001
REACT_APP_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Maintenance mode: off | notice | block
# notice keeps the app usable and shows instructions.
# block shows a maintenance page and prevents app routes from loading.
REACT_APP_MAINTENANCE_MODE=off
REACT_APP_MAINTENANCE_TITLE=Ocula is being updated
REACT_APP_MAINTENANCE_MESSAGE=Some features may change while maintenance is in progress.
REACT_APP_MAINTENANCE_INSTRUCTION=Avoid uploading sensitive images while maintenance changes are being tested.
REACT_APP_MAINTENANCE_RETRY_AFTER=within 48 hours
